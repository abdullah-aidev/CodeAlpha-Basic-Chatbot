# Task 3: Basic Chatbot

from datetime import datetime

def chatbot():
    print("\n================================")
    print("       PYTHON CHATBOT")
    print("================================")
    print("Hello! I am your Python chatbot.")
    print("Type 'help' to see what I can do.")
    print("Type 'bye' to exit the chat.\n")

    while True:
        user_input = input("You: ").strip().lower()

        if user_input in ["hello", "hi", "hey"]:
            print("Bot: Hello! How can I help you?")

        elif user_input in ["assalam-o-alaikum", "salam", "assalamualaikum"]:
            print("Bot: Wa Alaikum Assalam! How are you?")

        elif user_input in ["how are you", "how are you?"]:
            print("Bot: I am doing great! Thanks for asking.")

        elif user_input in ["what is your name", "your name"]:
            print("Bot: I am Python Chatbot, created for CodeAlpha Task 3.")

        elif user_input == "time":
            current_time = datetime.now().strftime("%I:%M %p")
            print(f"Bot: The current time is {current_time}.")

        elif user_input == "date":
            current_date = datetime.now().strftime("%d-%m-%Y")
            print(f"Bot: Today's date is {current_date}.")

        elif user_input == "help":
            print("\nBot: Here are some commands you can try:")
            print("- hello")
            print("- how are you")
            print("- what is your name")
            print("- time")
            print("- date")
            print("- bye")

        elif user_input in ["bye", "goodbye", "exit"]:
            print("Bot: Goodbye! Have a great day.")
            break

        elif user_input == "":
            print("Bot: Please type something.")

        else:
            print("Bot: Sorry, I don't understand that yet.")
            print("Bot: Type 'help' to see available commands.")


if __name__ == "__main__":
    chatbot()
